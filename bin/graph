#!/usr/bin/env bash
# Simple user-level control. Stop is graceful and never kills active Codex.
set -euo pipefail

SOURCE="$(readlink -f -- "${BASH_SOURCE[0]}")"
ROOT="$(cd -- "$(dirname -- "$SOURCE")/.." && pwd -P)"
UNIT="graph-community.service"
STATE="${VEZRYN_GRAPH_STATE:-$HOME/.local/state/graph-community}"
STOP="$STATE/stop-request"

usage() {
  echo 'Usage: graph {install|uninstall|start|stop|status|logs|repo|queue|capabilities|version|check-update|apply-update}'
  echo 'stop: cease new dispatch; let any in-flight coordinator finish'
  echo 'version/check-update/apply-update: --json; status: --details or --json'
}
active() { systemctl --user is-active --quiet "$UNIT"; }

case "${1:-}" in
  install|uninstall|start|stop)
    [ "$#" -eq 1 ] || { usage >&2; exit 2; }
    exec /usr/bin/python3 -B - "$ROOT" "$SOURCE" "$1" <<'PY'
"""Embedded Linux package lifecycle. No shell evaluation or data deletion."""
import fcntl
import os
from pathlib import Path
import re
import shutil
import stat
import subprocess
import sys
import tempfile

ROOT, SOURCE, ACTION = sys.argv[1:]
HOME = Path.home()
UNIT = 'graph-community.service'
UNIT_PATH = HOME / '.config/systemd/user' / UNIT
BIN = HOME / '.local/bin/graph'
CONFIG = Path(os.path.abspath(Path(os.environ.get('VEZRYN_GRAPH_CONFIG', HOME / '.config/graph-community/repos.toml')).expanduser()))
STATE = Path(os.path.abspath(Path(os.environ.get('VEZRYN_GRAPH_STATE', HOME / '.local/state/graph-community')).expanduser()))
PROFILE = {'VEZRYN_GRAPH_CONFIG': str(CONFIG), 'VEZRYN_GRAPH_STATE': str(STATE),
           'VEZRYN_GRAPH_LIBRARY': os.path.abspath(Path(os.environ.get('VEZRYN_GRAPH_LIBRARY', CONFIG.parent / 'library')).expanduser())}
STOP = STATE / 'stop-request'


def quote(value):
    # systemd.syntax quoting + specifier escaping. ExecStart uses ':' to disable
    # dollar environment substitution; Environment= does not do it.
    if any(ord(c) < 32 or ord(c) == 127 or 0xD800 <= ord(c) <= 0xDFFF for c in value):
        raise RuntimeError('Unsupported control character or undecodable path/environment')
    return '"' + value.replace('\\', '\\\\').replace('"', '\\"').replace('%', '%%') + '"'


def unit_text(path, profile=PROFILE):
    environment = {'PATH': path, **profile}
    return ('[Unit]\nDescription=Graph Community GitHub issue watcher\n\n[Service]\n'
            'Type=simple\nWorkingDirectory=' + ROOT.replace('%', '%%') + '\n' +
            ''.join('Environment=' + quote(key + '=' + value) + '\n' for key, value in environment.items()) +
            'ExecStart=:/usr/bin/python3 -u ' + quote(ROOT + '/watcher.py') + ' watch\nRestart=no\n')


def snapshot(path):
    try:
        info = path.lstat()
    except FileNotFoundError:
        return None
    if stat.S_ISLNK(info.st_mode):
        return ('link', os.readlink(path))
    if stat.S_ISREG(info.st_mode) and info.st_nlink == 1:
        return ('file', path.read_bytes(), stat.S_IMODE(info.st_mode))
    raise RuntimeError('Refusing special or hardlinked file: ' + str(path))


def installed_profile(value):
    """Return a bound profile, None for an exact old unit; reject foreign units."""
    if value is None:
        return None
    if value[0] != 'file':
        raise RuntimeError('Refusing nonowned unit installation')
    text = value[1].decode('utf-8')
    environment = {}
    for line in text.splitlines():
        if not line.startswith('Environment='):
            continue
        match = re.fullmatch(r'Environment="((?:[^"\\]|\\["\\])*)"', line)
        if not match:
            raise RuntimeError('Refusing modified unit environment')
        decoded = re.sub(r'\\(["\\])', r'\1', match[1]).replace('%%', '%')
        if 'Environment=' + quote(decoded) != line or '=' not in decoded:
            raise RuntimeError('Refusing modified unit environment')
        key, entry = decoded.split('=', 1)
        if key in environment:
            raise RuntimeError('Refusing duplicate unit environment')
        environment[key] = entry
    if set(environment) == {'PATH', *PROFILE}:
        profile = {key: environment[key] for key in PROFILE}
        if text == unit_text(environment['PATH'], profile):
            return profile
    # Only exact source-owned PATH-only predecessors can be rebound, while idle.
    if set(environment) != {'PATH'}:
        raise RuntimeError('Refusing nonowned unit installation')
    env = 'Environment=' + quote('PATH=' + environment['PATH']) + '\n'
    if text == unit_text(environment['PATH'], {}):
        return None
    # Exact previously shipped Linux unit: migration, including its unquoted
    # whitespace defect. A matching CLI alone never establishes unit ownership.
    legacy = ('[Unit]\nDescription=Graph Community GitHub issue watcher\n\n[Service]\n'
              'Type=simple\nWorkingDirectory=' + ROOT + '\n' + env +
              'ExecStart=/usr/bin/python3 -u ' + ROOT + '/watcher.py watch\nRestart=no\n')
    if text == legacy:
        return None
    raise RuntimeError('Refusing nonowned unit installation')


def manager():
    result = subprocess.run(['systemctl', '--user', 'show', UNIT,
        '--property=LoadState', '--property=FragmentPath', '--property=DropInPaths',
        '--property=ActiveState', '--property=MainPID', '--property=TasksCurrent',
        '--property=UnitFileState', '--property=NeedDaemonReload'], text=True, capture_output=True, timeout=30)
    values = dict(line.split('=', 1) for line in result.stdout.splitlines() if '=' in line)
    if result.returncode and not (result.returncode == 4 and values.get('LoadState') == 'not-found'):
        raise RuntimeError('Cannot inspect user manager: ' + result.stderr.strip())
    if values.get('LoadState') not in ('loaded', 'not-found'):
        raise RuntimeError('Unknown user manager unit state')
    fragment = values.get('FragmentPath', '')
    if (values.get('LoadState') == 'loaded' or fragment) and fragment != str(UNIT_PATH):
        raise RuntimeError('Refusing nonowned manager fragment: ' + fragment)
    if values.get('DropInPaths') or values.get('UnitFileState') in ('enabled', 'enabled-runtime', 'linked', 'linked-runtime', 'alias', 'masked', 'masked-runtime'):
        raise RuntimeError('Refusing manager overrides or startup links; preserve/reconcile them explicitly')
    return values


def ctl(*args):
    result = subprocess.run(['systemctl', '--user', *args], text=True, capture_output=True, timeout=30)
    if result.returncode:
        raise RuntimeError('systemctl ' + ' '.join(args) + ' failed: ' + result.stderr.strip())


def directories(path):
    # Never follow a user-install ancestor symlink into unrelated service state.
    for item in reversed((path, *path.parents)):
        if item.exists() or item.is_symlink():
            if not stat.S_ISDIR(item.lstat().st_mode):
                raise RuntimeError('Refusing non-directory installation ancestor: ' + str(item))
        else:
            item.mkdir(mode=0o700)


def replace(path, value):
    if value is None:
        path.unlink()
        return
    fd, name = tempfile.mkstemp(prefix='.graph-install-', dir=path.parent)
    temporary = Path(name)
    try:
        if value[0] == 'file':
            with os.fdopen(fd, 'wb') as output:
                output.write(value[1])
            temporary.chmod(value[2])
        else:
            os.close(fd)
            temporary.unlink()
            temporary.symlink_to(value[1])
        temporary.replace(path)
    finally:
        temporary.unlink(missing_ok=True)


def locked(path):
    file = os.fdopen(os.open(path, os.O_CREAT | os.O_RDWR | os.O_NOFOLLOW, 0o600), 'r+')
    try:
        info = os.fstat(file.fileno())
        if not stat.S_ISREG(info.st_mode) or info.st_nlink != 1 or info.st_uid != os.getuid() or info.st_mode & 0o077:
            raise RuntimeError('Refusing unsafe service-control lock')
        fcntl.flock(file, fcntl.LOCK_EX | fcntl.LOCK_NB)
        return file
    except BlockingIOError:
        file.close()
        raise RuntimeError('Graph activation or service control is in progress; refresh before changing service state') from None
    except BaseException:
        file.close()
        raise


def main():
    for value in (ROOT, SOURCE, str(HOME), os.environ.get('PATH', ''), *PROFILE.values()):
        quote(value)  # Validate before creating any installation file.
    # WorkingDirectory= takes a literal path, not a quoted word list. Unit-file
    # trailing whitespace/continuations cannot represent these paths safely.
    if ROOT[-1].isspace() or ROOT.endswith('\\'):
        raise RuntimeError('Unsupported trailing whitespace or backslash in source path')
    for tool, diagnostic in (('systemctl', 'Requires systemd user services'),
                             ('gh', 'GitHub CLI (gh) not on PATH'), ('codex', 'Codex CLI not on PATH')):
        if (ACTION == 'install' or tool == 'systemctl') and not shutil.which(tool):
            raise RuntimeError(diagnostic)
    directories(UNIT_PATH.parent)
    # The service is single-instance even when callers select different profiles.
    with locked(UNIT_PATH.parent / '.graph-community-control.lock'):
        before = {path: snapshot(path) for path in (UNIT_PATH, BIN)}
        profile = installed_profile(before[UNIT_PATH])
        if before[BIN] not in (None, ('link', SOURCE)):
            raise RuntimeError('Refusing to change nonowned unit or CLI installation')
        status = manager()
        if ACTION != 'install':
            if before[UNIT_PATH] is None:
                raise RuntimeError('Install this source before controlling its service')
            if profile is None:
                raise RuntimeError('Legacy service has no bound profile; verify its original state and drain it, then reinstall while idle to bind the selected profile')
            if profile != PROFILE:
                raise RuntimeError('Selected profile differs from the installed service; use the same VEZRYN_GRAPH_CONFIG, VEZRYN_GRAPH_STATE and VEZRYN_GRAPH_LIBRARY, or drain the installed profile and reinstall while idle')
            if status.get('NeedDaemonReload') != 'no':
                raise RuntimeError('Loaded service identity is unverified; reconcile/reload the owned unit before control')
        directories(STATE)
        directories(BIN.parent)
        with locked(STATE / 'update.lock'):
            if snapshot(UNIT_PATH) != before[UNIT_PATH] or snapshot(BIN) != before[BIN]:
                raise RuntimeError('Installation changed concurrently; refresh before control')
            change(before, status)


def change(before, status):
    if ACTION == 'stop':
        if status.get('ActiveState') == 'active':
            marker = snapshot(STOP)
            if marker is not None and marker[0] != 'file':
                raise RuntimeError('Refusing nonregular stop marker')
            if marker is None:
                replace(STOP, ('file', b'', 0o600))
            print('Graph stopping: no new issues will be dispatched.')
            print('Any in-flight Codex coordinator finishes before the watcher exits.')
        elif status.get('ActiveState') in ('inactive', 'failed') and status.get('MainPID', '0') == '0' and status.get('TasksCurrent', '0') in ('0', '[not set]'):
            print('Graph is already stopped.')
        else:
            raise RuntimeError('Service state is unverified; preserve it and refresh before requesting drain')
        return
    if ACTION == 'start':
        marker = snapshot(STOP)
        if marker is not None and marker[0] != 'file':
            raise RuntimeError('Refusing nonregular stop marker')
        if marker is not None:
            STOP.unlink()
        try:
            if status.get('ActiveState') != 'active':
                ctl('start', UNIT)
            confirmed = manager()
            if confirmed.get('ActiveState') != 'active' or confirmed.get('NeedDaemonReload') != 'no':
                raise RuntimeError('Manager did not confirm an active watcher with current unit identity')
        except (RuntimeError, OSError, subprocess.TimeoutExpired):
            if marker is not None and snapshot(STOP) is None:
                replace(STOP, marker)
            raise
        print('Graph watcher started. Use: graph status')
        return
    if status.get('ActiveState') not in ('inactive', 'failed') or status.get('MainPID', '0') != '0' or status.get('TasksCurrent', '0') not in ('0', '[not set]'):
        raise RuntimeError('Service is active or unverified; graph stop and wait for a verified drain first')
    desired = ({UNIT_PATH: ('file', unit_text(os.environ['PATH']).encode(), 0o644), BIN: ('link', SOURCE)}
               if ACTION == 'install' else {UNIT_PATH: None, BIN: None})
    changed = []
    try:
        for path, value in desired.items():
            if value != before[path]:
                if snapshot(path) != before[path]:
                    raise RuntimeError('Installation changed concurrently: ' + str(path))
                replace(path, value)
                changed.append(path)
        ctl('daemon-reload')
        loaded = manager()['LoadState']
        if loaded != ('loaded' if ACTION == 'install' else 'not-found'):
            raise RuntimeError('Manager did not confirm the requested installation state')
    except (RuntimeError, OSError, subprocess.TimeoutExpired) as error:
        rollback = []
        for path in reversed(changed):
            try:
                if snapshot(path) != desired[path]:
                    raise RuntimeError('changed concurrently; preserved')
                replace(path, before[path])
            except (RuntimeError, OSError) as failure:
                rollback.append(str(path) + ': ' + str(failure))
        try:
            ctl('daemon-reload')
        except (RuntimeError, OSError, subprocess.TimeoutExpired) as failure:
            rollback.append('manager reload remains unverified: ' + str(failure))
        raise RuntimeError(str(error) + '; owned file changes rolled back' +
                           ('; rollback incomplete: ' + '; '.join(rollback) if rollback else ''))
    print(('Installed service and CLI (not started or enabled).' if ACTION == 'install' else
           'Uninstalled service and CLI. Package source and all configuration, state, journals, claims and worktrees preserved.'))


try:
    main()
except (RuntimeError, OSError, ValueError, subprocess.TimeoutExpired) as error:
    print(str(error), file=sys.stderr)
    raise SystemExit(1)

PY
    ;;
  status)
    if [ "$#" -eq 2 ] && [ "$2" = "--json" ]; then
      exec /usr/bin/python3 -B "$ROOT/watcher.py" "$@"
    fi
    [ "$#" -eq 1 ] || { [ "$#" -eq 2 ] && [ "$2" = "--details" ]; } || { usage >&2; exit 2; }
    if active; then
      if [ -e "$STOP" ]; then
        echo "Graph: stopping (draining active coordinator, if any)"
      else
        echo "Graph: running"
      fi
    else
      echo "Graph: stopped"
    fi
    /usr/bin/python3 "$ROOT/watcher.py" "$@"
    ;;
  capabilities)
    [ "$#" -eq 1 ] || { usage >&2; exit 2; }
    exec /usr/bin/python3 "$ROOT/graph_platform.py"
    ;;
  version|check-update|apply-update)
    exec /usr/bin/python3 -B "$ROOT/graph_update.py" "$@"
    ;;
  logs)
    exec journalctl --user -u "$UNIT" --no-pager -n 40 -f
    ;;
  queue)
    exec /usr/bin/python3 -B "$ROOT/watcher.py" "$@"
    ;;
  repo)
    shift
    exec /usr/bin/python3 "$ROOT/watcher.py" repo "$@"
    ;;
  -h|--help|help)
    usage
    ;;
  *)
    usage >&2
    exit 2
    ;;
esac
